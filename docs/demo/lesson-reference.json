  ],
  "reference_sentences": [
    {
      "start": 0.7,
      "end": 5.465,
      "text": "这是一节专门为程序验收编写的自制短课。"
    },
    {
      "start": 5.665,
      "end": 10.84,
      "text": "我们用一个小例子说明线性模型和最小二乘。"
    },
    {
      "start": 11.04,
      "end": 13.9,
      "text": "设计矩阵有三行两列。"
    },
    {
      "start": 14.1,
      "end": 19.615,
      "text": "第一列全部为一，第二列依次为零、一、二。"
    },
    {
      "start": 19.815,
      "end": 24.275,
      "text": "参数向量包含截距和斜率两个分量。"
    },
    {
      "start": 24.475,
      "end": 27.9,
      "text": "取截距为一，斜率为二。"
    },
    {
      "start": 28.1,
      "end": 32.5,
      "text": "三个预测值依次为一、三、五。"
    },
    {
      "start": 32.7,
      "end": 37.05,
      "text": "此时预测值与三个观测值完全一致。"
    },
    {
      "start": 38.7,
      "end": 44.05,
      "text": "一般情况下，观测值不一定严格落在直线上。"
    },
    {
      "start": 44.25,
      "end": 49.865,
      "text": "最小二乘让预测值与观测值的残差平方和最小。"
    },
    {
      "start": 50.065,
      "end": 54.74,
      "text": "平方误差同时惩罚正向和负向的偏差。"
    },
    {
      "start": 54.94,
      "end": 60.35,
      "text": "把目标函数对参数求导，可以得到正规方程。"
    },
    {
      "start": 60.55,
      "end": 65.77,
      "text": "正规方程表示设计矩阵转置乘以残差等于零。"
    },
    {
      "start": 65.97,
      "end": 70.645,
      "text": "设计矩阵满列秩时，最小二乘解唯一。"
    },
    {
      "start": 70.845,
      "end": 75.955,
      "text": "如果矩阵不满列秩，最小二乘解仍然存在。"
    },
    {
      "start": 76.155,
      "end": 80.355,
      "text": "但是，这时参数向量可能不唯一。"
    },
    {
      "start": 82.2,
      "end": 86.425,
      "text": "现在把第三个观测值从五改成六。"
    },
    {
      "start": 86.625,
      "end": 91.12,
      "text": "这三个点不再严格位于同一条直线上。"
    },
    {
      "start": 91.32,
      "end": 95.3,
      "text": "最小二乘得到的截距是六分之五。"
    },
    {
      "start": 95.5,
      "end": 98.44,
      "text": "得到的斜率是二分之五。"
    },
    {
      "start": 98.64,
      "end": 104.57,
      "text": "三个残差依次是六分之一、负三分之一和六分之一。"
    },
    {
      "start": 104.77,
      "end": 108.475,
      "text": "残差与设计矩阵的两列都正交。"
    },
    {
      "start": 108.675,
      "end": 113.805,
      "text": "这就是把观测向量投影到设计矩阵的列空间。"
    },
    {
      "start": 114.005,
      "end": 118.985,
      "text": "残差非零，并不等于最小二乘问题无解。"
    }
  ],
  "video_sha256": "678af8476e0b1df82529ea03055bf0dc038809f05d06216f3136a9cb5f6dd841"
}