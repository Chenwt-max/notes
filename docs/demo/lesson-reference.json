{
  "script_sha256": "c8364adc48c85451c0bf6061612cb7f935426010dd10cee00599f8e164898d99",
  "synthetic_voice": "local Windows zh-CN TTS",
  "duration_seconds": 120.0,
  "slide_durations": [
    38.0,
